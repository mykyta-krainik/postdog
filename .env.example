# Copy to .env at the repo root. Real environment variables override this file.
# Comments stay on their own lines: Node's .env parser can read an inline comment as the value.

# LLM
ANTHROPIC_API_KEY=
# Only if an OpenAI model is used.
OPENAI_API_KEY=
# true = scripted mock model. The mock is also used when the key of the LLM_MODEL provider is missing.
LLM_MOCK=false
# provider:model from the AI SDK registry. Providers: anthropic, openai.
LLM_MODEL=anthropic:claude-sonnet-5-5

# API
API_PORT=4000
# A relative path resolves from the repo root.
DATABASE_PATH=./apps/api/data/postdog.db

# Langfuse (optional; tracing is off unless both keys are set).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse JS SDK v6 (@langfuse/otel) reads LANGFUSE_BASE_URL; v2 used LANGFUSE_BASEURL. Empty = https://cloud.langfuse.com.
LANGFUSE_BASE_URL=
