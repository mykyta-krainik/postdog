# Copy to .env at the repo root. Real environment variables override this file.
# Comments stay on their own lines: Node's .env parser can read an inline comment as the value.

# LLM. The agents arrive in phase 2. Until then the API reads none of these keys.
ANTHROPIC_API_KEY=
# Only if an OpenAI model is used.
OPENAI_API_KEY=
# true = scripted mock model (also used when the provider key is missing).
LLM_MOCK=false
# provider:model from the AI SDK registry.
LLM_MODEL=anthropic:claude-sonnet-5-5

# API
API_PORT=4000
# A relative path resolves from the repo root.
DATABASE_PATH=./apps/api/data/postdog.db

# Langfuse (optional; tracing is off when empty). Unused until phase 2.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Confirm the variable name for the SDK version in use.
LANGFUSE_BASE_URL=
